<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela Apelido: conteúdo à esquerda, bloco centralizado na vertical.
  LinearLayout + widgets padrão do tema.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Como você quer ser chamado?"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvApoio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Esse nome vai para quem estiver por perto no mesh."
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary" />

    <EditText
        android:id="@+id/etApelido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Seu apelido no mesh"
        android:inputType="text"
        android:maxLines="1" />

    <Button
        android:id="@+id/btnEntrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="ENTRAR" />
</LinearLayout>
