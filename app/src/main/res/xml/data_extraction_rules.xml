<?xml version="1.0" encoding="utf-8"?>
<!--
    Anti-clone da identidade: exclui o prefs de identidade do backup em nuvem e do
    device-to-device, para o aparelho restaurado nao herdar o secret (mesmo peerID) nem
    o `verificado` alheio.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="aerotalks_identidade.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="aerotalks_identidade.xml" />
    </device-transfer>
</data-extraction-rules>
